# Copy to .env.local (never commit .env.local). Everything here is optional:
# with nothing set the site works, and the quote form logs and skips email instead of sending.

# --- Quote notification + catalog email (Gmail SMTP) ---
# Mailbox the site sends FROM (a Gmail address you control).
QUOTE_FROM_EMAIL=quotes@example.com
# Where the shop receives the quote details + CSV.
QUOTE_NOTIFY_EMAIL=owner@example.com
# Gmail App Password for QUOTE_FROM_EMAIL (myaccount.google.com/apppasswords). Rotate it if it was ever shared or committed.
GMAIL_APP_PASSWORD=

# --- Optional: append each quote to a Google Sheet ---
# Share the sheet with the service account (Editor). Sheet ID is in the URL: docs.google.com/spreadsheets/d/SHEET_ID/edit
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Optional: live tentative rates in the emailed catalog ---
# SERPER_API_KEY=
# OPENAI_API_KEY=

# --- Analytics ---
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Unset = no tracking, no script loaded.
# Also add it in Vercel > Project > Settings > Environment Variables (it is read at build time).
NEXT_PUBLIC_GA_ID=

# Production host is fixed in lib/site.ts and is NOT read from this variable.
# Honoured only by `next dev`, to test SEO output against another local origin.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
